#!/bin/bash
set -uo pipefail

if ! command -v gcloud >/dev/null 2>&1; then
  printf ' unavailable\n'
  exit 0
fi

account="$(gcloud auth list --filter='status:ACTIVE' --format='value(account)' 2>/dev/null | head -n 1)" || {
  printf ' auth error\n'
  exit 0
}

if [ -z "$account" ]; then
  printf ' not logged in\n'
  exit 0
fi

project="$(gcloud config get-value project 2>/dev/null | head -n 1)" || {
  printf ' %s / project error\n' "$account"
  exit 0
}

if [ -z "$project" ] || [ "$project" = "(unset)" ]; then
  printf ' %s / no project\n' "$account"
  exit 0
fi

printf ' %s / %s\n' "$account" "$project"
