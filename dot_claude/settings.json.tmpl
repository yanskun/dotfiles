{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "language": "japanese",
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Read(~/**)",
      "Bash(go *)",
      "Bash(xargs go:*)",
      "Bash(gofmt *)",
      "Bash(xargs gofmt:*)",
      "Bash(golint *)",
      "Bash(xargs golint:*)",
      "Bash(golangci-lint *)",
      "Bash(xargs golangci-lint:*)",
      "Bash(make)",
      "Bash(make *)",
      "Bash(xargs make:*)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(xargs git:*)",
      "Bash(gh *)",
      "Bash(xargs gh:*)",
      "Bash(npm *)",
      "Bash(xargs npm:*)",
      "Bash(yarn)",
      "Bash(yarn *)",
      "Bash(xargs yarn:*)",
      "Bash(pnpm *)",
      "Bash(xargs pnpm:*)",
      "Bash(bun *)",
      "Bash(xargs bun:*)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(xargs ls:*)",
      "Bash(cat *)",
      "Bash(xargs cat:*)",
      "Bash(bat *)",
      "Bash(xargs bat:*)",
      "Bash(grep *)",
      "Bash(xargs grep:*)",
      "Bash(rg *)",
      "Bash(xargs rg:*)",
      "Bash(find *)",
      "Bash(xargs find:*)",
      "Bash(fd *)",
      "Bash(xargs fd:*)",
      "Bash(mkdir *)",
      "Bash(xargs mkdir:*)",
      "Bash(touch *)",
      "Bash(xargs touch:*)",
      "Bash(cp *)",
      "Bash(xargs cp:*)",
      "Bash(echo *)",
      "Bash(xargs echo:*)",
      "Bash(which *)",
      "Bash(xargs which:*)",
      "Bash(pwd)",
      "Bash(cd *)",
      "Bash(tree)",
      "Bash(tree *)",
      "Bash(xargs tree:*)",
      "Bash(jq *)",
      "Bash(xargs jq:*)",
      "Bash(head *)",
      "Bash(xargs head:*)",
      "Bash(tail *)",
      "Bash(xargs tail:*)",
      "Bash(wc *)",
      "Bash(xargs wc:*)",
      "Bash(sort *)",
      "Bash(xargs sort:*)",
      "Bash(awk *)",
      "Bash(xargs awk:*)",
      "Bash(sed *)",
      "Bash(xargs sed:*)",
      "Bash(date)",
      "Bash(date *)",
      "Bash(whoami)",
      "Bash(env)",
      "Bash(export *)",
      "Bash(history)",
      "mcp__typescript__move_file",
      "mcp__typescript__move_directory",
      "mcp__typescript__rename_symbol",
      "mcp__typescript__delete_symbol",
      "mcp__typescript__find_references",
      "mcp__typescript__get_definitions",
      "mcp__typescript__get_diagnostics",
      "mcp__typescript__get_module_symbols",
      "mcp__typescript__get_type_in_module",
      "mcp__typescript__get_type_at_symbol",
      "mcp__typescript__get_symbols_in_scope",
      "mcp__typescript__lsp_find_references",
      "mcp__typescript__lsp_get_definitions",
      "mcp__typescript__lsp_zget_diagnostics",
      "mcp__serena",
      "mcp__context7",
      "mcp__github"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf /*)",
      "Bash(sudo rm *)",
      "Bash(sudo *)",
      "Bash(dd *)",
      "Bash(> /dev/*)",
      "Bash(>> /dev/*)",
      "Bash(chmod 777 /*)",
      "Bash(chown root:*)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)",
      "Bash(rm -rf .git)",
      "Bash(git push --force-with-lease origin main)",
      "Bash(git push -f origin main)",
      "Edit(/etc/**)",
      "Edit(/usr/**)",
      "Edit(/var/**)",
      "Edit(/opt/**)",
      "Edit(/bin/**)",
      "Edit(/sbin/**)",
      "Edit(/lib/**)",
      "Edit(~/.ssh/id_*)",
      "Edit(~/.ssh/*_rsa)",
      "Edit(~/.ssh/*_ecdsa)",
      "Edit(~/.ssh/*_ed25519)",
      "Edit(/etc/passwd)",
      "Edit(/etc/shadow)",
      "Edit(/etc/sudoers)",
      "Write(/etc/**)",
      "Write(/usr/**)",
      "Write(/var/**)",
      "Write(/opt/**)",
      "Write(/bin/**)",
      "Write(/sbin/**)",
      "Write(/lib/**)",
      "Write(~/.ssh/id_*)",
      "Write(~/.ssh/*_rsa)",
      "Write(~/.ssh/*_ecdsa)",
      "Write(~/.ssh/*_ed25519)",
      "Write(/etc/passwd)",
      "Write(/etc/shadow)",
      "Write(/etc/sudoers)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "docker *",
      "git worktree *",
      "gcloud *",
      "tmux *",
      "open *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.local/share/pnpm",
        "./.claude/worktrees/**"
      ],
      "allowRead": [
        "~/.config/gh", 
        "./.claude/worktrees/**"
      ],
      "denyRead": [
        "./secrets/**",
        "./.env",
        "./.env.*",
        "**/.env",
        "**/.env.*",
        "**/credentials.json",
        "**/.npmrc"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "registry.yarnpkg.com"
      ],
      "allowLocalBinding": true
    },
    "enableWeakerNetworkIsolation": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash {{ .chezmoi.homeDir }}/.tmux/plugins/tmux-agent-sidebar/hook.sh claude session-start"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash {{ .chezmoi.homeDir }}/.tmux/plugins/tmux-agent-sidebar/hook.sh claude session-end"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash {{ .chezmoi.homeDir }}/.tmux/plugins/tmux-agent-sidebar/hook.sh claude user-prompt-submit"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash {{ .chezmoi.homeDir }}/.claude/notify-completion.sh stop"
          },
          {
            "type": "command",
            "command": "bash {{ .chezmoi.homeDir }}/.tmux/plugins/tmux-agent-sidebar/hook.sh claude stop"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash {{ .chezmoi.homeDir }}/.tmux/plugins/tmux-agent-sidebar/hook.sh claude stop-failure"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash {{ .chezmoi.homeDir }}/.claude/notify-completion.sh notification"
          },
          {
            "type": "command",
            "command": "bash {{ .chezmoi.homeDir }}/.tmux/plugins/tmux-agent-sidebar/hook.sh claude notification"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash {{ .chezmoi.homeDir }}/.claude/log-subagent.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(*.ts)|Edit(*.tsx)|Write(*.ts)|Write(*.tsx)",
            "command": "echo '[React Best Practices Review Required] .ts/.tsx ファイルが変更されました。react-best-practices-reviewer サブエージェントを起動して、変更されたコードが React 公式ドキュメントのベストプラクティスに準拠しているかレビューしてください。'"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash {{ .chezmoi.homeDir }}/.tmux/plugins/tmux-agent-sidebar/hook.sh claude activity-log"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true
  },
  "voiceEnabled": true,
  "skipAutoPermissionPrompt": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754085492520
  },
  "statusLine": {
    "type": "command",
    "command": "bash {{ .chezmoi.homeDir }}/.claude/statusline-command.sh"
  }
}
