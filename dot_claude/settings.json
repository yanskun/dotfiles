      "Bash(xargs go:*)",
      "Bash(gofmt *)",
      "Bash(xargs gofmt:*)",
      "Bash(golint *)",
      "Bash(xargs golint:*)",
      "Bash(golangci-lint *)",
      "Bash(xargs golangci-lint:*)",
      "Bash(make)",
      "Bash(make *)",
      "Bash(xargs make:*)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(xargs git:*)",
      "Bash(gh *)",
      "Bash(xargs gh:*)",
      "Bash(npm *)",
      "Bash(xargs npm:*)",
      "Bash(yarn)",
      "Bash(yarn *)",
      "Bash(xargs yarn:*)",
      "Bash(pnpm *)",
      "Bash(xargs pnpm:*)",
      "Bash(bun *)",
      "Bash(xargs bun:*)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(xargs ls:*)",
      "Bash(cat *)",
      "Bash(xargs cat:*)",
      "Bash(bat *)",
      "Bash(xargs bat:*)",
      "Bash(grep *)",
      "Bash(xargs grep:*)",
      "Bash(rg *)",
      "Bash(xargs rg:*)",
      "Bash(find *)",
      "Bash(xargs find:*)",
      "Bash(fd *)",
      "Bash(xargs fd:*)",
      "Bash(mkdir *)",
      "Bash(xargs mkdir:*)",
      "Bash(touch *)",
      "Bash(xargs touch:*)",
      "Bash(cp *)",
      "Bash(xargs cp:*)",
      "Bash(echo *)",
      "Bash(xargs echo:*)",
      "Bash(which *)",
      "Bash(xargs which:*)",
      "Bash(pwd)",
      "Bash(cd *)",
      "Bash(tree)",
      "Bash(tree *)",
      "Bash(xargs tree:*)",
      "Bash(jq *)",
      "Bash(xargs jq:*)",
      "Bash(head *)",
      "Bash(xargs head:*)",
      "Bash(tail *)",
      "Bash(xargs tail:*)",
      "Bash(wc *)",
      "Bash(xargs wc:*)",
      "Bash(sort *)",
      "Bash(xargs sort:*)",
      "Bash(awk *)",
      "Bash(xargs awk:*)",
      "Bash(sed *)",
      "Bash(xargs sed:*)",
      "Bash(date)",
      "Bash(date *)",
      "Bash(whoami)",
      "Bash(env)",
      "Bash(export *)",
      "Bash(history)",
      "mcp__typescript__move_file",
      "mcp__typescript__move_directory",
      "mcp__typescript__rename_symbol",
      "mcp__typescript__delete_symbol",
      "mcp__typescript__find_references",
      "mcp__typescript__get_definitions",
      "mcp__typescript__get_diagnostics",
      "mcp__typescript__get_module_symbols",
      "mcp__typescript__get_type_in_module",
      "mcp__typescript__get_type_at_symbol",
      "mcp__typescript__get_symbols_in_scope",
      "mcp__typescript__lsp_find_references",
      "mcp__typescript__lsp_get_definitions",
      "mcp__typescript__lsp_zget_diagnostics",
      "mcp__serena",
      "mcp__context7",
      "mcp__github"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf /*)",
      "Bash(sudo rm *)",
      "Bash(sudo *)",
      "Bash(dd *)",
      "Bash(> /dev/*)",
      "Bash(>> /dev/*)",
      "Bash(chmod 777 /*)",
      "Bash(chown root:*)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)",
      "Bash(rm -rf .git)",
      "Bash(git push --force-with-lease origin main)",
      "Bash(git push -f origin main)",
      "Edit(/etc/**)",
      "Edit(/usr/**)",
      "Edit(/var/**)",
      "Edit(/opt/**)",
      "Edit(/bin/**)",
      "Edit(/sbin/**)",
      "Edit(/lib/**)",
      "Edit(~/.ssh/id_*)",
      "Edit(~/.ssh/*_rsa)",
      "Edit(~/.ssh/*_ecdsa)",
      "Edit(~/.ssh/*_ed25519)",
      "Edit(/etc/passwd)",
      "Edit(/etc/shadow)",
      "Edit(/etc/sudoers)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.netrc)",
      "Read(~/.pgpass)",
      "Read(~/.npmrc)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/id_ecdsa)",
      "Read(**/*credentials*)",
      "Bash(cat ~/.aws/**)",
      "Bash(cat ~/.ssh/**)",
      "Bash(cat ~/.config/gh/**)",
      "Bash(cat ~/.gnupg/**)",
      "Bash(cat ~/.netrc)",
      "Bash(cat ~/.pgpass)",
      "Bash(cat ~/.npmrc)",
      "Bash(head ~/.aws/**)",
      "Bash(head ~/.ssh/**)",
      "Bash(head ~/.config/gh/**)",
      "Bash(tail ~/.aws/**)",
      "Bash(tail ~/.ssh/**)",
      "Bash(tail ~/.config/gh/**)",
      "Bash(less ~/.aws/**)",
      "Bash(less ~/.ssh/**)",
      "Bash(less ~/.config/gh/**)",
      "Bash(bat ~/.aws/**)",
      "Bash(bat ~/.ssh/**)",
      "Bash(bat ~/.config/gh/**)",
      "Bash(grep * ~/.aws/**)",
      "Bash(grep * ~/.ssh/**)",
      "Bash(grep * ~/.config/gh/**)",
      "Bash(rg * ~/.aws/**)",
      "Bash(rg * ~/.ssh/**)",
      "Bash(rg * ~/.config/gh/**)",
      "Bash(jq * ~/.aws/**)",
      "Bash(jq * ~/.config/gh/**)",
      "Bash(awk * ~/.aws/**)",
      "Bash(awk * ~/.ssh/**)",
      "Bash(awk * ~/.config/gh/**)",
      "Bash(sed * ~/.aws/**)",
      "Bash(sed * ~/.ssh/**)",
      "Bash(sed * ~/.config/gh/**)",
      "Bash(xxd ~/.aws/**)",
      "Bash(xxd ~/.ssh/**)",
      "Bash(base64 ~/.aws/**)",
      "Bash(base64 ~/.ssh/**)",
      "Bash(od * ~/.ssh/**)",
      "Bash(curl -d *)",
      "Bash(curl --data *)",
      "Bash(curl --data-binary *)",
      "Bash(curl --data-raw *)",
      "Bash(curl -F *)",
      "Bash(curl --form *)",
      "Bash(curl -T *)",
      "Bash(curl --upload-file *)",
      "Bash(wget --post-data *)",
      "Bash(wget --post-file *)"
    ],
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/naoyayasuda/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/log-subagent.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-outside-worktree.sh"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/log-skill-usage.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/naoyayasuda/.claude/hooks/rtk-rewrite.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[React Best Practices Review Required] .ts/.tsx ファイルが変更されました。react-best-practices-reviewer サブエージェントを起動して、変更されたコードが React 公式ドキュメントのベストプラクティスに準拠しているかレビューしてください。'",
            "if": "Edit(*.ts)|Edit(*.tsx)|Write(*.ts)|Write(*.tsx)"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "codex@openai-codex": true,
    "ponytail@ponytail": true,
    "security-guidance@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "language": "japanese",
  "sandbox": {
    "enabled": false,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "registry.yarnpkg.com"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "~/.local/share/pnpm",
        "./.claude/worktrees/**"
      ],
      "denyRead": [
        "./secrets/**",
        "./.env",
        "./.env.*",
        "**/.env",
        "**/.env.*",
        "**/credentials.json",
        "**/.npmrc"
      ],
      "allowRead": [
        "~/.config/gh",
        "./.claude/worktrees/**"
      ]
    },
    "enableWeakerNetworkIsolation": true,
    "excludedCommands": [
      "docker *",
      "git worktree *",
      "gcloud *",
      "tmux *",
      "open *",
      "make *"
    ]
  },
  "effortLevel": "high",
  "advisorModel": "fable",
  "voice": {
    "enabled": false,
    "mode": "tap"
  },
  "skipWorkflowUsageWarning": true,
  "switchModelsOnFlag": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "prStatusFooterEnabled": false,
  "feedbackSurveyState": {
    "lastShownTime": 1754085492520
  }
}
