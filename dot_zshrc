## github
### rate limit
function ghrl() {
  gh api /rate_limit | jq -r '
    def fmt(k):
      .[k] | "\(k)|\(.remaining)/\(.limit)|\(.reset | localtime | strftime("%H:%M:%S"))|\(((.reset - now) / 60) | floor)m";
    "TYPE|USAGE|RESET|IN",
    (.resources | fmt("core"), fmt("graphql"), fmt("search"))
  ' | column -t -s '|'
}

## fzf
### ghq
function fzf-src () {
  local selected_dir=$(ghq list | fzf-tmux -p --height 40% --reverse --preview "bat --color=always --style=header,grid --line-range :80 $(ghq root)/{}/README.*")
  if [ -n "$selected_dir" ]; then
    BUFFER="cd $(ghq root)/${selected_dir}"
    zle accept-line
  fi
}
zle -N fzf-src
bindkey '^]' fzf-src

### open github
function fzf-open () {
  local selected_dir=$(ghq list | fzf-tmux -p --height 40% --reverse --preview "bat --color=always --style=header,grid --line-range :80 $(ghq root)/{}/README.*")
  if [ -n "$selected_dir" ]; then
    BUFFER="open https://${selected_dir}"
    zle accept-line
  fi
}
zle -N fzf-open
bindkey '^o' fzf-open

## gcloud project swhich
function gcloud_prj_switch () {
    local project="$(gcloud projects list | tail -n +2 | fzf-tmux -p --height 40% --reverse | awk '{print $1}')"
    if [ -n "$project" ]; then
        BUFFER="gcloud config set project ${project}"
        zle accept-line
    fi
}
zle -N gcloud_prj_switch
bindkey '^p' gcloud_prj_switch

## gcloud auth account switch
function gcloud_auth_switch () {
    local account="$(
        gcloud auth list --format="value(account)" \
        | fzf-tmux -p --height 40% --reverse
    )"

    if [ -n "$account" ]; then
        BUFFER="gcloud config set account ${account}"
        zle accept-line
    fi
}
zle -N gcloud_auth_switch
bindkey '^g' gcloud_auth_switch

## history by atuin
function atuin-history-selection() {
    if [ -z "${TMUX}" ]; then
        output=$(RUST_LOG=error atuin search $* -i -- $BUFFER 3>&1 1>&2 2>&3)
    else
        tmpdir=$(mktemp -d)
        mkfifo "$tmpdir/pipe"
        trap "rm -rf '$tmpdir'" EXIT HUP INT TERM
        output=$(
            cat "$tmpdir/pipe" &;
            tmux display-popup -d $(pwd) -E -E -h 50% -e "ATUIN_SESSION=$ATUIN_SESSION" -- \
                "$(printf "%q " RUST_LOG=error atuin search $* -i -- $BUFFER) 1>&2 2>$tmpdir/pipe"
        )
        rm -rf "$tmpdir"
    fi

    if [[ -n $output ]]; then
        RBUFFER=""
        LBUFFER=$output
        zle accept-line
    fi

}
zle -N atuin-history-selection
bindkey '^H' atuin-history-selection

