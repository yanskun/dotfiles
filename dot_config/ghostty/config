auto-update-channel = tip

font-family = Hack Nerd Font Mono
font-size = 12
font-thicken = true
font-family = Hiragino Kaku Gothic ProN

background-opacity = 0.8
background = 1C2021
cursor-opacity = 0.7

mouse-hide-while-typing = true
macos-option-as-alt = true

macos-titlebar-style = hidden

cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

initial-command = /bin/zsh -c '/opt/homebrew/bin/tmux attach-session || /opt/homebrew/bin/tmux new-session -s default'

window-decoration = false
macos-non-native-fullscreen = visible-menu
fullscreen = true
window-padding-x = 8
window-padding-y = 4

theme = original

keybind = cmd+r=reload_config
keybind = cmd+u=toggle_background_opacity

keybind = global:ctrl+y=toggle_visibility
keybind = global:ctrl+backquote=toggle_quick_terminal

quick-terminal-size = 100%,100%

background = "1e2127"
